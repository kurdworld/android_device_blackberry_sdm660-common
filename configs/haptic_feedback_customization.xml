<haptic-feedback-constants>
    <!-- Physical key/button feedback: use the full motor amplitude so short
         presses still register strongly. -->
    <constant id="0">
        <vibration-effect>
            <waveform-effect>
                <waveform-entry durationMs="40" amplitude="255"/>
            </waveform-effect>
        </vibration-effect>
    </constant>

    <constant id="1">
        <vibration-effect>
            <waveform-effect>
                <waveform-entry durationMs="30" amplitude="255"/>
            </waveform-effect>
        </vibration-effect>
    </constant>

    <constant id="3">
        <vibration-effect>
            <waveform-effect>
                <waveform-entry durationMs="30" amplitude="255"/>
            </waveform-effect>
        </vibration-effect>
    </constant>

    <constant id="6">
        <vibration-effect>
            <waveform-effect>
                <waveform-entry durationMs="30" amplitude="255"/>
            </waveform-effect>
        </vibration-effect>
    </constant>

    <constant id="16">
        <vibration-effect>
            <waveform-effect>
                <waveform-entry durationMs="40" amplitude="255"/>
            </waveform-effect>
        </vibration-effect>
    </constant>

    <constant id="17">
        <vibration-effect>
            <waveform-effect>
                <waveform-entry durationMs="50" amplitude="255"/>
                <waveform-entry durationMs="70" amplitude="0"/>
                <waveform-entry durationMs="30" amplitude="255"/>
            </waveform-effect>
        </vibration-effect>
    </constant>

    <!--
        BIOMETRIC_CONFIRM

        The motor needs a little time to spin up, so use a longer full-strength
        pulse than the legacy 30 ms fallback. This is also the fallback for the
        power-button long press.
    -->
    <constant id="10003">
        <vibration-effect>
            <waveform-effect>
                <waveform-entry durationMs="40" amplitude="255"/>
            </waveform-effect>
        </vibration-effect>
    </constant>

    <constant id="10004">
        <vibration-effect>
            <waveform-effect>
                <waveform-entry durationMs="60" amplitude="255"/>
            </waveform-effect>
        </vibration-effect>
    </constant>

    <!--
        BIOMETRIC_REJECT

        Match the legacy double-click shape, but longer and at full amplitude.
    -->
    <constant id="10005">
        <vibration-effect>
            <waveform-effect>
                <waveform-entry durationMs="50" amplitude="255"/>
                <waveform-entry durationMs="80" amplitude="0"/>
                <waveform-entry durationMs="50" amplitude="255"/>
            </waveform-effect>
        </vibration-effect>
    </constant>
</haptic-feedback-constants>
