<!-- USB Audio HAL Audio Policy Configuration file

     Only USB accessories (AUDIO_DEVICE_OUT_USB_ACCESSORY) are handled by the
     generic AOSP USB HAL. USB headsets and USB DACs are routed by the primary
     QCOM HAL through its AFE USB_AUDIO_RX/USB_AUDIO_TX backends, like every
     other QCOM audio policy configuration. Declaring them here as well would
     give two HALs the same device and the in-call voice stream could be sent
     to the module that cannot bridge Telephony Rx.
-->

<module name="usb" halVersion="2.0">
    <mixPorts>
        <mixPort name="usb_accessory output" role="source">
            <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
                     samplingRates="44100" channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
        </mixPort>
    </mixPorts>
    <devicePorts>
        <devicePort tagName="USB Host Out" type="AUDIO_DEVICE_OUT_USB_ACCESSORY" role="sink">
            <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
                     samplingRates="44100" channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
        </devicePort>
    </devicePorts>
    <routes>
        <route type="mix" sink="USB Host Out"
               sources="usb_accessory output"/>
    </routes>
</module>
