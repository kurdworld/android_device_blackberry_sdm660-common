allow hal_power_default self:capability {dac_override sys_resource};
allow hal_power_default sysfs_touch_wake_gesture:file rw_file_perms;
# Thermal throttling callbacks from the QTI thermal HAL
hal_client_domain(hal_power_default, hal_thermal)

# CPU, GPU and memory-bus frequency limits
allow hal_power_default sysfs_devices_system_cpu:file rw_file_perms;
allow hal_power_default vendor_sysfs_devfreq:dir r_dir_perms;
allow hal_power_default vendor_sysfs_devfreq:file rw_file_perms;
allow hal_power_default vendor_sysfs_devfreq:lnk_file read;
allow hal_power_default vendor_sysfs_kgsl:dir r_dir_perms;
allow hal_power_default vendor_sysfs_kgsl:file rw_file_perms;
allow hal_power_default vendor_sysfs_kgsl:lnk_file read;
r_dir_file(hal_power_default, vendor_sysfs_graphics)
set_prop(hal_power_default, vendor_power_prop)
